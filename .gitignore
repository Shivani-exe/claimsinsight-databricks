# Keep authentication, local deployment state, and machine settings private.
.env
.env.*
.databrickscfg
.databricks/
.bundle/
.codex/
*token-cache*
*credentials*
*secrets*
*.pem
*.key

# Source deliveries and generated stream state belong in Unity Catalog storage.
*.csv
*.csv.gz
*.parquet
*.zip
*.dbc
data/
landing/
incoming/
checkpoints/
schemas/

# Ignore local Python and editor artifacts.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
.idea/
.vscode/
.DS_Store
Thumbs.db
work/
